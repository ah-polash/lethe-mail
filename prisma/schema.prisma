generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  passwordHash   String
  role           String   @default("general_user") // super_admin | general_user
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaigns         Campaign[]
  templates         EmailTemplate[]
  aiPrompts         AiPrompt[]
  dynamicTemplates  DynamicTemplate[]
  emailSequences    EmailSequence[]
  sequenceTemplates SequenceTemplate[]
  feedbackReports   FeedbackReport[]
}

// Bug reports & feature requests submitted from the sidebar. Any authenticated
// user can submit and view; only super admins change `status`.
model FeedbackReport {
  id            String   @id @default(uuid())
  type          String   @default("bug") // bug | feature
  title         String
  description   String
  screenshotUrl String?
  status        String   @default("waiting_initial_review") // waiting_initial_review | reviewed | under_development | fixed_shipped
  createdBy     String
  creator       User     @relation(fields: [createdBy], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

// Library of email templates generated from a sequence's "Generate all email
// steps" action. Mirrors DynamicTemplate but tagged with sequence/step/product
// context so they can be browsed on their own page.
model SequenceTemplate {
  id           String   @id @default(uuid())
  name         String
  subject      String?
  htmlContent  String
  sequenceId   Int?
  sequenceName String?
  stepNumber   Int?
  productName  String?
  createdBy    String
  creator      User     @relation(fields: [createdBy], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sequenceId])
}

// A numbered list of AI-designed email steps. There is NO built-in scheduler:
// the external system (e.g. a WordPress plugin) fires a specific step by POSTing
// the contact payload to /send/{id}/{stepNumber}. The `id` is the numeric
// sequence id shown in the webhook URL; each step is addressed by its 1-based
// stepNumber.
model EmailSequence {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  fromEmail    String   @default("")
  fromName     String   @default("bPlugins")
  status       String   @default("active") // active | paused
  sequenceType String   @default("freemius_event") // freemius_event | lead_nurture | upsell | cross_sell | discount | free_to_paid | win_back | renewal | review_request | gift_from_ceo
  emailField   String   @default("email") // dot-path to the recipient email in the webhook payload
  eventField   String   @default("type")  // dot-path to the event name in the payload (Freemius: "type")
  webhookToken String   @unique @default(uuid()) // secret for the /send endpoint
  createdBy    String
  creator      User     @relation(fields: [createdBy], references: [id])
  steps        EmailSequenceStep[]
  sends        SequenceSendLog[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EmailSequenceStep {
  id          String   @id @default(uuid())
  sequenceId  Int
  sequence    EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  stepNumber  Int      // 1-based, addressed directly in the send URL
  name        String?
  eventType   String?  // when the sequence webhook receives this event name, this step fires
  subject     String   @default("")
  htmlContent String   @default("")
  aiPrompt    String?  // captured prompt used to generate this step (if AI)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sequenceId, stepNumber])
  @@index([sequenceId])
}

// Audit log of every fired step send. Also powers idempotency-free reporting.
model SequenceSendLog {
  id         String   @id @default(uuid())
  sequenceId Int
  sequence   EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  stepNumber Int
  email      String
  status     String   @default("sent") // sent | suppressed | failed
  messageId  String?
  error      String?
  createdAt  DateTime @default(now())

  @@index([sequenceId])
  @@index([email])
}

model SesConfig {
  id               String   @id @default(uuid())
  name             String   @default("Default")
  region           String
  accessKeyId      String
  secretAccessKey  String
  configSetName    String?
  defaultFromEmail String?
  isActive         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model EmailTemplate {
  id          String   @id @default(uuid())
  name        String
  subject     String
  htmlContent String
  jsonContent String?  // For drag-and-drop editor state
  thumbnail   String?
  isAiGenerated Boolean @default(false)
  createdBy   String
  creator     User     @relation(fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns   Campaign[]
}

model Campaign {
  id              String   @id @default(uuid())
  name            String
  subject         String
  fromEmail       String   @default("")
  fromName        String   @default("")
  htmlContent     String
  templateId      String?
  template        EmailTemplate? @relation(fields: [templateId], references: [id])
  status          String   @default("draft") // draft | scheduled | sending | sent | failed
  scheduledAt     DateTime?
  sentAt          DateTime?
  totalRecipients Int      @default(0)
  totalSent       Int      @default(0)
  totalDelivered  Int      @default(0)
  totalOpened     Int      @default(0)
  totalClicked    Int      @default(0)
  totalBounced    Int      @default(0)
  totalComplaints Int      @default(0)
  totalUnsubscribed Int    @default(0)
  audienceSource  String   @default("internal") // internal | swipeone
  recipientEmails String?  // JSON array of recipient email addresses
  segmentIds      String?  // JSON array of SwipeOne segment IDs (future use)
  segmentNames    String?  // JSON array of segment names for display (future use)
  categoryId      String?
  category        CampaignCategory? @relation(fields: [categoryId], references: [id])
  createdBy       String
  creator         User     @relation(fields: [createdBy], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  events          CampaignEvent[]
}

model CampaignEvent {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  email      String
  eventType  String   // sent | delivered | opened | clicked | bounced | complained | unsubscribed
  metadata   String?  // JSON
  createdAt  DateTime @default(now())
}

model Contact {
  id                    String   @id @default(uuid())
  email                 String   @unique
  firstName             String?
  lastName              String?
  fullName              String?
  tags                  String?  // JSON array of tags
  isMarketingAllowed    Boolean  @default(true)
  emailMarketingConsent Boolean  @default(false)
  pluginSlug            String?
  uninstallFeedback     String?
  feedbackText          String?
  properties            String?  // JSON object for extra custom fields
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model SwipeOneConfig {
  id          String   @id @default(uuid())
  name        String   @default("Default")
  apiKey      String
  baseUrl     String   @default("https://api.swipeone.com")
  workspaceId String   @default("")
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Audit trail of suppression tags successfully pushed to SwipeOne. Driven by
// markContactAsUnsubscribed/Complained/Bounced. The suppressions page reads
// this so the "Added Tag" column reflects what we actually sent (and SwipeOne
// accepted with a 200 OK), not a guess.
model SwipeOneTagAudit {
  id          String   @id @default(uuid())
  email       String   @unique
  tags        String   // JSON array of tag strings
  lastReason  String?  // unsubscribed | complained | bounced
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Dev/test only — captures every inbound webhook POST (currently SES via SNS)
// raw, plus the resolved metadata our handler extracted. Used by the campaign
// log viewer so we can verify SNS data is being received correctly.
model WebhookLog {
  id          String   @id @default(uuid())
  source      String   @default("ses-sns")
  type        String?  // SNS Type — SubscriptionConfirmation | Notification | Unhandled
  eventType   String?  // Bounce | Complaint | Delivery | Open | Click | Reject | ...
  messageId   String?
  email       String?
  campaignId  String?  // resolved campaign id if we matched one
  status      String   @default("received") // received | confirmed | processed | unmatched | error | unhandled
  result      String?  // human-readable processing outcome
  raw         String   // raw request body as JSON string
  createdAt   DateTime @default(now())

  @@index([campaignId])
  @@index([messageId])
  @@index([eventType])
}

model PopularVariable {
  id        String   @id @default(uuid())
  name      String   @unique
  label     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiConfig {
  id        String   @id @default(uuid())
  name      String   @default("Default")
  provider  String   @default("openrouter") // openrouter | openai
  apiKey    String
  model     String   @default("google/gemini-2.0-flash-001")
  baseUrl   String   @default("https://openrouter.ai/api/v1")
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model R2Config {
  id              String   @id @default(uuid())
  name            String   @default("Default")
  accountId       String
  accessKeyId     String
  secretAccessKey String
  bucketName      String
  publicUrl       String   // e.g. https://pub-xxx.r2.dev or custom domain
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Freemius developer-scope API credentials. Multiple accounts supported (like
// R2Config); the active one is used to pull the products/plugins list into the
// Email Sequence editor. Auth is HMAC-SHA256 request signing (dev id + public +
// secret key) — see src/lib/freemius.ts.
model FreemiusConfig {
  id          String   @id @default(uuid())
  name        String   @default("Default")
  developerId String
  publicKey   String
  secretKey   String
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DynamicTemplate {
  id          String   @id @default(uuid())
  name        String
  subject     String?
  htmlContent String
  source      String   @default("manual") // "manual" | "ai"
  aiMode      String?  // for AI sources: "true" | "product-update"
  prompt      String?  // captured prompt for AI sources
  createdBy   String
  creator     User     @relation(fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiPrompt {
  id                String   @id @default(uuid())
  prompt            String
  style             String   @default("professional")
  name              String?  // template name used
  subject           String?  // subject used
  referenceImageUrl String?  // screenshot reference image URL
  aiMode            String   @default("true") // "true" | "screenshot" | "product-update"
  generatedHtml     String?  // cached generation result for "Use Previous Result"
  generatedSubject  String?  // cached subject from the same generation
  createdBy         String
  creator           User     @relation(fields: [createdBy], references: [id])
  createdAt         DateTime @default(now())
}

model Product {
  id              String   @id @default(uuid())
  name            String
  logoUrl         String?
  wpOrgSlug       String?
  landingPageUrl  String?
  pricingPageUrl  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CampaignCategory {
  id                     String   @id @default(uuid())
  name                   String   @unique
  slug                   String   @unique
  description            String?
  swipeOneTagOverride    String?  // when set, used as the SwipeOne tag instead of `slug`
  autoCheckOnUnsubscribe Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  campaigns    Campaign[]
  unsubscribes CategoryUnsubscribe[]
}

model CategoryUnsubscribe {
  id         String   @id @default(uuid())
  email      String
  categoryId String
  category   CampaignCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  campaignId String?
  createdAt  DateTime @default(now())

  @@unique([email, categoryId])
  @@index([email])
  @@index([categoryId])
}

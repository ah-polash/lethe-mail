generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  passwordHash   String
  role           String   @default("general_user") // super_admin | general_user
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaigns        Campaign[]
  templates        EmailTemplate[]
  aiPrompts        AiPrompt[]
  dynamicTemplates DynamicTemplate[]
}

model SesConfig {
  id              String   @id @default(uuid())
  name            String   @default("Default")
  region          String
  accessKeyId     String
  secretAccessKey String
  configSetName   String?
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EmailTemplate {
  id          String   @id @default(uuid())
  name        String
  subject     String
  htmlContent String
  jsonContent String?  // For drag-and-drop editor state
  thumbnail   String?
  isAiGenerated Boolean @default(false)
  createdBy   String
  creator     User     @relation(fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns   Campaign[]
}

model Campaign {
  id              String   @id @default(uuid())
  name            String
  subject         String
  fromEmail       String   @default("")
  fromName        String   @default("")
  htmlContent     String
  templateId      String?
  template        EmailTemplate? @relation(fields: [templateId], references: [id])
  status          String   @default("draft") // draft | scheduled | sending | sent | failed
  scheduledAt     DateTime?
  sentAt          DateTime?
  totalRecipients Int      @default(0)
  totalSent       Int      @default(0)
  totalDelivered  Int      @default(0)
  totalOpened     Int      @default(0)
  totalClicked    Int      @default(0)
  totalBounced    Int      @default(0)
  totalComplaints Int      @default(0)
  totalUnsubscribed Int    @default(0)
  audienceSource  String   @default("internal") // internal | swipeone
  recipientEmails String?  // JSON array of recipient email addresses
  segmentIds      String?  // JSON array of SwipeOne segment IDs (future use)
  segmentNames    String?  // JSON array of segment names for display (future use)
  createdBy       String
  creator         User     @relation(fields: [createdBy], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  events          CampaignEvent[]
}

model CampaignEvent {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  email      String
  eventType  String   // sent | delivered | opened | clicked | bounced | complained | unsubscribed
  metadata   String?  // JSON
  createdAt  DateTime @default(now())
}

model Contact {
  id                    String   @id @default(uuid())
  email                 String   @unique
  firstName             String?
  lastName              String?
  fullName              String?
  tags                  String?  // JSON array of tags
  isMarketingAllowed    Boolean  @default(true)
  emailMarketingConsent Boolean  @default(false)
  pluginSlug            String?
  uninstallFeedback     String?
  feedbackText          String?
  properties            String?  // JSON object for extra custom fields
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model SwipeOneConfig {
  id          String   @id @default(uuid())
  name        String   @default("Default")
  apiKey      String
  baseUrl     String   @default("https://api.swipeone.com")
  workspaceId String   @default("")
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Audit trail of suppression tags successfully pushed to SwipeOne. Driven by
// markContactAsUnsubscribed/Complained/Bounced. The suppressions page reads
// this so the "Added Tag" column reflects what we actually sent (and SwipeOne
// accepted with a 200 OK), not a guess.
model SwipeOneTagAudit {
  id          String   @id @default(uuid())
  email       String   @unique
  tags        String   // JSON array of tag strings
  lastReason  String?  // unsubscribed | complained | bounced
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PopularVariable {
  id        String   @id @default(uuid())
  name      String   @unique
  label     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiConfig {
  id        String   @id @default(uuid())
  name      String   @default("Default")
  provider  String   @default("openrouter") // openrouter | openai
  apiKey    String
  model     String   @default("google/gemini-2.0-flash-001")
  baseUrl   String   @default("https://openrouter.ai/api/v1")
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model R2Config {
  id              String   @id @default(uuid())
  name            String   @default("Default")
  accountId       String
  accessKeyId     String
  secretAccessKey String
  bucketName      String
  publicUrl       String   // e.g. https://pub-xxx.r2.dev or custom domain
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DynamicTemplate {
  id          String   @id @default(uuid())
  name        String
  subject     String?
  htmlContent String
  source      String   @default("manual") // "manual" | "ai"
  aiMode      String?  // for AI sources: "true" | "product-update"
  prompt      String?  // captured prompt for AI sources
  createdBy   String
  creator     User     @relation(fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiPrompt {
  id                String   @id @default(uuid())
  prompt            String
  style             String   @default("professional")
  name              String?  // template name used
  subject           String?  // subject used
  referenceImageUrl String?  // screenshot reference image URL
  aiMode            String   @default("true") // "true" | "screenshot" | "product-update"
  generatedHtml     String?  // cached generation result for "Use Previous Result"
  generatedSubject  String?  // cached subject from the same generation
  createdBy         String
  creator           User     @relation(fields: [createdBy], references: [id])
  createdAt         DateTime @default(now())
}
